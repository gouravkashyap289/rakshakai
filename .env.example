# Network enrichment is opt-in. Gemini receives selected findings only on request.
ENABLE_NETWORK_LOOKUPS=false
ENABLE_URL_REDIRECT_CHECKS=false
RAKSHAK_API_KEY=
# Set true behind HTTPS. Visitor cookies are HttpOnly and SameSite=Strict.
COOKIE_SECURE=false
DATABASE_URL=sqlite:////data/rakshak.db
# Leave empty for arbitrary uploaded email. Only allow headers from an independently trusted ingestion chain.
TRUSTED_AUTHSERV_IDS=
VERIFY_DKIM=false
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=
URLHAUS_API_KEY=
OTX_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# Must exactly match the site's public origin and registered OAuth callback URLs.
PUBLIC_BASE_URL=http://127.0.0.1:5173
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Generate once with cryptography.fernet.Fernet.generate_key(); preserve across restarts.
TOKEN_ENCRYPTION_KEY=
GEOLITE2_CITY_PATH=
GEOLITE2_ASN_PATH=
# Optional local fine-tuned transformer with labels phishing and benign.
RAKSHAK_MODEL_PATH=
